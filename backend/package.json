{
  "name": "kanlungan-coffee-garage-api",
  "version": "1.0.0",
  "description": "Backend API for Kanlungan Coffee Garage POS",
  "main": "server.js",
  "scripts": {
    "start": "node migrate.js && node server.js",
    "dev": "nodemon server.js",
    "migrate": "node migrate.js",
    "audit:data": "node audit-data.js",
    "check:sync-schema": "node check-sync-schema.js",
    "cleanup:legacy-menu": "node cleanup-legacy-menu.js --execute",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
