# Existing Render PostgreSQL connection URL (never commit the real value)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
PORT=3000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Generate both independently. Production rejects values under 16 characters.
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_PEPPER=replace-with-a-different-32-character-secret

ALLOWED_ORIGINS=https://your-service.onrender.com
DEFAULT_BRANCH_ID=main

# Keep true only while old tablets are being migrated.
LEGACY_SYNC_ENABLED=true

# Temporary compatibility key. Rotate it after migration.
API_KEY=replace-with-the-former-shared-api-key

# Latest Android POS APK download shown in Cloud Devices.
APK_DOWNLOAD_URL=https://example.com/coffeepos-latest.apk
APK_VERSION_NAME=1.10
APK_VERSION_CODE=11
